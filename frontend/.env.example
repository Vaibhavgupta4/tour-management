# Copy to .env.local (local dev, gitignored) or set in Vercel/Netlify dashboard
# Must start with REACT_APP_ — value is baked into the build

# Backend API base — include the /api/v1 prefix, no trailing slash
REACT_APP_API_URL=http://localhost:4000/api/v1

# For production e.g.:
# REACT_APP_API_URL=https://your-backend.onrender.com/api/v1
# REACT_APP_API_URL=https://your-backend.railway.app/api/v1
